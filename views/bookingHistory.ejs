<!DOCTYPE html>
<html>
<head>
<title>Booking History</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-dark bg-dark">
<div class="container">
<a class="navbar-brand">My Bookings</a>
<a href="/dashboard" class="btn btn-light">Back</a>
</div>
</nav>

<div class="container mt-4">
<table class="table table-bordered">
<tr>
<th>Movie</th>
<th>Date</th>
<th>Time</th>
<th>Seats</th>
<th>Cancel</th>
</tr>
<% data.forEach(b => { %>
<tr>
<td><%= b.showId.movieId.title %></td>
<td><%= b.showId.date %></td>
<td><%= b.showId.time %></td>
<td><%= b.seats %></td>
<td>
<a href="/cancel/<%= b._id %>" class="btn btn-danger btn-sm">Cancel</a>
</td>
</tr>
<% }) %>
</table>
</div>
</body>
</html>