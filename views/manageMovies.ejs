<!DOCTYPE html>
<html>
<head>
<title>Manage Movies</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-dark bg-dark navbar-expand-lg">
<div class="container">
<a class="navbar-brand">Admin Panel</a>
<ul class="navbar-nav ms-auto">
<li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
<li class="nav-item"><a class="nav-link active" href="/movies">Manage Movies</a></li>
<li class="nav-item"><a class="nav-link" href="/shows">Shows</a></li>
<li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
</ul>
</div>
</nav>

<div class="container mt-4">
<h4>Movies</h4>
<a href="/addMovie" class="btn btn-primary mb-3">Add Movie</a>
<table class="table table-bordered">
<tr>
<th>Title</th>
<th>Description</th>
<th>Action</th>
</tr>
<% data.forEach(m => { %>
<tr>
<td><%= m.title %></td>
<td><%= m.description %></td>
<td>
<a href="/editMovie/<%= m._id %>" class="btn btn-warning btn-sm">Edit</a>
<a href="/deleteMovie/<%= m._id %>" class="btn btn-danger btn-sm">Delete</a>
</td>
</tr>
<% }) %>
</table>
</div>
</body>
</html>