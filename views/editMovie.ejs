<!DOCTYPE html>
<html>
<head>
<title>Edit Movie</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-5 col-md-5">
<h4>Edit Movie</h4>
<form method="post" action="/updateMovie/<%= movie._id %>">
<input name="title" value="<%= movie.title %>" class="form-control mb-2" required>
<textarea name="description" class="form-control mb-2" required><%= movie.description %></textarea>
<button class="btn btn-primary w-100">Update</button>
</form>
</div>
</body>
</html>