<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

<!-- SIMPLE NAVBAR -->
<nav class="navbar navbar-dark bg-dark navbar-expand-lg">
    <div class="container">
        <a class="navbar-brand">Movie Booking</a>

        <ul class="navbar-nav ms-auto">

            <% if(user.role === "admin"){ %>

                <li class="nav-item">
                    <a class="nav-link" href="/movies">Manage Movies</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="/shows">Manage Shows</a>
                </li>

            <% } else { %>

                <li class="nav-item">
                    <a class="nav-link" href="/history">My Bookings</a>
                </li>

            <% } %>

            <li class="nav-item">
                <a class="nav-link" href="/logout">Logout</a>
            </li>

        </ul>
    </div>
</nav>


<div class="container mt-4">

    <!-- USERNAME -->
    <h3>Welcome <%= user.name %></h3>
    <hr>


    <!-- ⭐ ADMIN DASHBOARD -->
   <% if(user.role === "admin"){ %>


        <h4>Admin Dashboard</h4>

        <div class="row">

            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <h5>Total Movies</h5>
                        <h3><%= movies.length %></h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <h5>Total Shows</h5>
                        <h3><%= shows.length %></h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <h5>Total Bookings</h5>
                        <h3><%= bookings.length %></h3>
                    </div>
                </div>
            </div>

        </div>

        <hr>

        <h5>Recent Bookings</h5>

        <table class="table table-bordered">
            <tr>
                <th>User</th>
                <th>Movie</th>
                <th>Seats</th>
            </tr>

            <% bookings.forEach(b => { %>
                <tr>
                    <td><%= b.userId %></td>
                    <td><%= b.showId.movie %></td>
                    <td><%= b.seats %></td>
                </tr>
            <% }) %>
        </table>



    <!-- ⭐ USER DASHBOARD -->
    <% } else { %>

        <h4>Available Shows</h4>

        <table class="table table-striped text-dark">
            <tr>
                <th>Movie</th>
                <th>Date</th>
                <th>Time</th>
                <th>Book</th>
            </tr>

            <% shows.forEach(s => { %>
                <tr>
                    <td><%= s.movieId?.title || "No Movie" %></td>
                    <td><%= new Date(s.date).toDateString() %></td>
                    <td><%= s.time %></td>
                    <td>
                        <a href="/booking/<%= s._id %>" class="btn btn-primary btn-sm">
                            Book
                        </a>
                    </td>
                </tr>
            <% }) %>
        </table>

    <% } %>

</div>

</body>
</html>
